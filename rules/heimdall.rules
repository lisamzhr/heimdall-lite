alert tcp any any -> $HOME_NET any (msg:"HEIMDALL Possible TCP SYN scan (100+ SYNs from one source in 5s)"; flags:S; threshold:type both, track by_src, count 100, seconds 5; classtype:attempted-recon; sid:9000001; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"HEIMDALL Possible SSH brute force (5+ new connections from one source in 60s)"; flags:S; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-recon; sid:9000002; rev:1;)
